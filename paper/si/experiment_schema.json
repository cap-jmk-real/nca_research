{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nca_research.local/si/experiment_schema.json",
  "title": "NCA research experiment record",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "date",
    "hypothesis_ids",
    "hardware",
    "software",
    "data",
    "model",
    "training",
    "metrics",
    "artifacts",
    "repro"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{8}-[0-9]{3}$"
    },
    "title": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["smoke", "preliminary", "primary", "superseded", "failed", "running"]
    },
    "date": { "type": "string", "description": "ISO date of completion or last update" },
    "hypothesis_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "claims_supported": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Short claim strings safe for paper Results"
    },
    "claims_not_supported": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hardware": { "type": "object" },
    "software": { "type": "object" },
    "data": { "type": "object" },
    "model": { "type": "object" },
    "training": { "type": "object" },
    "metrics": { "type": "object" },
    "baselines": { "type": "object" },
    "artifacts": {
      "type": "object",
      "description": "Paths on external SSD or in-repo docs"
    },
    "repro": {
      "type": "object",
      "required": ["command", "seed"],
      "properties": {
        "command": { "type": "string" },
        "seed": { "type": ["integer", "string"] },
        "git_commit": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    },
    "related_experiments": {
      "type": "array",
      "items": { "type": "string" }
    },
    "si_notes": { "type": "string" }
  }
}
